rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read access for the free public standings/schedule site (index.html).
    // Writes require an authenticated (anonymous) client — gated behind the
    // admin PIN in admin.html.
    match /{collection}/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
